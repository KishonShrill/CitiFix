        "@vinext/cloudflare": "^1.0.0-beta.8",
        "animejs": "^4.5.0",
        "better-auth": "^1.6.33",
        "cloudinary": "^2.11.0",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "lucide-react": "^1.43.0",
        "maplibre-gl": "^6.10.0",
        "nanoid": "^6.0.1",
        "next": "^16.3.5",
        "pg": "^8.23.0",
        "postgres": "^3.4.9",
        "react": "latest",
        "react-dom": "latest",
        "react-map-gl": "^8.1.3",
        "react-server-dom-webpack": "^19.3.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.6.0",
        "vinext": "^1.0.0-beta.10"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.54.11",
        "@tailwindcss/postcss": "latest",
        "@tanstack/eslint-plugin-query": "^5.103.1",
        "@types/node": "latest",
        "@types/pg": "^8.23.1",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitejs/plugin-rsc": "^0.5.35",
        "dotenv": "^18.0.1",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.5",
        "lint-staged": "^17.5.1",
        "next-cloudinary": "^6.19.3",
        "react-scan": "^0.5.7",
        "supabase": "2.117.0",
        "tailwindcss": "latest",
        "typescript": "latest",
        "vite": "^8.3.0",
        "wrangler": "^4.133.0"
    },
    "type": "module",
    "scripts": {
        "dev": "vinext dev --hostname 0.0.0.0",
        "prebuild": "npm run cf-typegen",
        "build": "vinext build",
        "start": "wrangler dev --config dist/server/wrangler.json",
        "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
        "db:seed": "node --import tsx -e \"import 'dotenv/config'; await import('./lib/seed.ts')\"",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
    }
}
